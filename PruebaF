#Se seleccionan los datos Inhibidor y Control como dos vectores diferentes
ActividadInhibidor<-subset(datos, Tratamiento=="Inhibidor")
ActividadControl<-subset(datos, Tratamiento=="Control")

#La prueba se pide en el órden Inhibidor/Control de manera que se divide varianza chica/varianza grande
var.test(ActividadInhibidor$Actividad,ActividadControl$Actividad,alternative="two.sided")

#La prueba se pide en el órden Inhibidor/Control de manera que se divide varianza grande/varianza chica
var.test(ActividadControl$Actividad,ActividadInhibidor$Actividad,alternative="two.sided")

