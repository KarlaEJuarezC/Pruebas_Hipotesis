#Para hacer gráfica de distribución F
f<-seq(0,13,.001)
y<-df(f,3,3) # Se pone 3 y 3 porque esos son los grados de libertad 1 y 2
plot(f,y,pch=".",col.main="darkgray",xlab="Valores de F",ylab= "Densidad de probabilidad", font.lab=2, cex.lab=1.5, cex.axis=1.3)
abline(h=0)

#Se calcula el F crítico izquierdo
Fcriticoi<- qf(0.025, 3,3, lower.tail = TRUE) #alfa/2=0.025, g.l=6, cola izquierda=lower.tail=TRUE
Fcriticoi
c<-seq(0,Fcriticoi,0.001) # Genera 1000 valores desde t crítico hasta el 0
d<-df(c,3,3) #Genera distribución t para los valores generados en "c" usando 6 g.l.
polygon(c(0, c, Fcriticoi),c(0,d,0),col="midnightblue") #Colorea sólo la zona de alfa

#Se calcula el F crítico derecho
Fcriticod<- qt(0.025, 3,3, lower.tail = FALSE) #alfa/2=0.025, g.l=9, cola derecha=lower.tail=FALSE
Fcriticod
a<-seq(Fcriticod,13,0.001) # Genera 1000 valores desde t crítico hasta el 4
b<-df(a,3,3) #Genera distribución t para los valores generados en "a" usando 9 g.l.
polygon(c(Fcriticod,a,13),c(0,b,0),col="midnightblue") #Colorea sólo la zona de alfa

