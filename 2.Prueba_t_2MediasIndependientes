#Realizar prueba de t de cola izquierda, en la que se tiene como hipótesis alternativa que Mu de Inhibidor será MENOR que MU de Control
t.test(Actividad~Tratamiento, data=datos, alternative="less")


# Se programa una función para calcular error estándar
se <- function(a)
{
  return(sd(a, na.rm=TRUE)/sqrt(length(a)))
}

#A continuación se programa una función llamada data_summary en la que se calcularan media y error estandar usando la libreria plyr
data_summary <- function(data, varname, groupnames){
  require(plyr)
  summary_func <- function(x, col){
    c(mean = mean(x[[col]], na.rm=TRUE), se = se(x[[col]]))
  }
  data_sum<-ddply(data, groupnames, .fun=summary_func,  varname)
  data_sum <- rename(data_sum, c("mean" = varname))
  return(data_sum)
}

#Se genera una base de datos con las medias y error estándar de la actividad enzimática en función de los tratamientos. 
Resumen<- data_summary(datos, varname="Actividad",  groupnames=c("Tratamiento"))
Resumen

#Para generar el gráfico de medias con error estándar
library(ggplot2)
#En aes(x....) se tiene que especificar que se reordenaran los Tratamientos en función del valor de la Actividad, para que así, coloque como primer barra la media de actividad en Control y como segunda,
#la media de actividad en  Inhibidor. 
grafica<-ggplot(Resumen, aes(x = reorder(Tratamiento, -Actividad), y=Actividad, fill=Tratamiento)) + 
  geom_bar(stat="identity", position=position_dodge()) +
  ylim(0, 30) +
  geom_errorbar(aes(ymin=Actividad-se, ymax=Actividad+se), width=.2,
                position=position_dodge(.9))+
  scale_fill_manual(values=c('#855C75', '#D9AF6B'))+
  labs( title="Columnas (medias)   ", 
        subtitle="+/- Error estándar", caption="Elaboración en R") +
  annotate("text", label = "*", x = 1, y = 42, size = 3, colour = "black", fontface = "bold")+
  theme_minimal()
  
#Se almacena la gráfica en formato jpg, de 20 x 15 cm
ggsave( "Figura7.15.jpg", grafica, width = 20, height = 15, units = "cm")


