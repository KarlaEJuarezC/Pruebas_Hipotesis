#Descargar achivo "datos_T2mediasIndependientes.csv" en una carpeta en la computadora 
#Leer el archivo de datos, señalando su ubicación  en la computadora
datos<-read.csv(file.choose(), header = T) 

# Conocer como están estructurados los datos
str(datos)

#Especificar que tratamiento es un factor. Se puede indicar el orden poniendo primero inhibidor y luego control, o al revés, depende del orden en el que se quiera hacer la prueba 
datos$Tratamiento<-factor(datos$Tratamiento, levels=c("Inhibidor", "Control"))

#Conocer estadisticos descriptuvos y realizar prueba de Shapiro Wilk en las dos poblaciones estadísticas ( el tratamiento Control y el tratamiento Inhibidor)
library(doBy)
summaryBy(Actividad~Tratamiento, data=datos, FUN=function(x){
  c(m=mean(x), de=sd(x),se=sd(x)/length(x), var=var(x) n=length(x), shapiro=shapiro.test(x))})

